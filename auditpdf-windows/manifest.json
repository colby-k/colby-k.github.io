{
  "id": "/auditpdf-windows/",
  "name": "AuditPDF",
  "short_name": "AuditPDF",
  "description": "Audit-focused PDF review and annotation workspace.",
  "start_url": "/auditpdf-windows/",
  "scope": "/auditpdf-windows/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {"src":"icon-192.png?v=1","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"icon-512.png?v=1","sizes":"512x512","type":"image/png","purpose":"any"}
  ],
  "file_handlers": [
    {
      "action": "/auditpdf-windows/",
      "accept": {
        "application/pdf": [".pdf"],
        "application/x-auditpdf": [".auditpdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
